{
  "title": "Understanding the impact of precision quantization on the accuracy and energy of neural networks",
  "study_type": "controlled experiment",
  "data_quality": "comparative",
  "energy_measurement": {
    "measurement_method": ["analytical"],
    "repetitions": 1
  },
