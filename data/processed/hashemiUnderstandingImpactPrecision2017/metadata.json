    "quantization_targets": ["w-q0.4, a-q.04", "w-q0.8, a-q.08", "w-q0.16, a-q0.16", "w-q0.32, a-q0.32", "w-int6, a-q0.16", "w-int1, a-q0.16"],
    "quantization_method": "quantization-aware training",
    "frameworks": ["ristretto"],
    "formats": ["power-of-two"]
